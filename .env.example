# --- ฐานข้อมูล (Neon Postgres) ---
# ใช้ connection string แบบ pooled สำหรับรันแอป
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/htc_insights?sslmode=require"
# แบบ direct (ไม่ผ่าน pooler) สำหรับ prisma migrate เท่านั้น
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/htc_insights?sslmode=require"

# --- Auth.js (NextAuth v5) ---
# สร้างด้วย: npx auth secret
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- กฎการคัดกรองสิทธิ์ ---
# อีเมลที่ลงท้ายด้วยโดเมนนี้จะได้บทบาท STUDENT อัตโนมัติ นอกนั้นเป็น EXTERNAL
ALLOWED_STUDENT_DOMAIN=""
# อีเมลผู้ดูแลระดับสูงคนแรก ใช้ตอน seed เท่านั้น ห้ามฝังลงโค้ด
SUPER_ADMIN_EMAIL=""

# --- อัปโหลดรูป (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- ค้นหาสถานที่ (SerpApi) --- ใช้ฝั่งเซิร์ฟเวอร์เท่านั้น ห้ามใส่ NEXT_PUBLIC_
SERPAPI_KEY=""

# --- ชั่วคราว: ดูหน้าตาแต่ละบทบาทระหว่างยังไม่มีระบบล็อกอิน (ลบใน Phase 1) ---
# STUDENT | EXTERNAL | ADMIN — เว้นว่าง = ผู้เยี่ยมชม ไม่มีผลบน production
DEV_ROLE=""

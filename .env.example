# --- ฐานข้อมูล (SQLite ไฟล์เดียว) ---
# ใช้ทั้ง prisma migrate และแอป — relative นับจาก root ของโปรเจกต์
# บนเซิร์ฟเวอร์จริงใช้ path เต็มนอกโฟลเดอร์โค้ด เช่น file:/var/lib/htc-insights/htc.db
DATABASE_URL="file:./prisma/dev.db"

# --- Auth.js (NextAuth v5) ---
# สร้างด้วย: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
# Google Cloud Console → OAuth client (Web application) → Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google            (dev)
#   https://<โดเมนจริง>/api/auth/callback/google               (production)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# บนเซิร์ฟเวอร์ส่วนตัวหลัง reverse proxy ต้องตั้งค่านี้ (หรือตั้ง AUTH_URL เป็นโดเมนจริงแทน)
AUTH_TRUST_HOST=true

# --- กฎการคัดกรองสิทธิ์ ---
# อีเมลที่ลงท้ายด้วยโดเมนนี้จะได้บทบาท STUDENT อัตโนมัติ นอกนั้นเป็น EXTERNAL
ALLOWED_STUDENT_DOMAIN=""
# อีเมลผู้ดูแลระดับสูงคนแรก ได้สิทธิ์ตอนเข้าสู่ระบบด้วย Google ครั้งแรก — ต้องตั้งก่อนคนนั้นล็อกอิน ห้ามฝังลงโค้ด
SUPER_ADMIN_EMAIL=""

# --- อัปโหลดรูป (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- ค้นหาสถานที่ (SerpApi) --- ใช้ฝั่งเซิร์ฟเวอร์เท่านั้น ห้ามใส่ NEXT_PUBLIC_
SERPAPI_KEY=""

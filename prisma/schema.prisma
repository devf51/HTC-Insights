// HTC Insights v2 — ระบบฐานข้อมูลสถานประกอบการนักศึกษาวิทยาลัยเทคนิคหาดใหญ่
// อ่าน docs/context.md ก่อนแก้ไฟล์นี้ โดยเฉพาะหลักการโดเมน 4 ข้อ

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
  // partial unique index — ใช้กับ JobPosting_open_per_department
  previewFeatures = ["partialIndexes"]
}

// SQLite ไฟล์เดียว รันบนเซิร์ฟเวอร์ส่วนตัว — ไม่มี scalar list และไม่มีชนิดคอลัมน์แบบ @db.*
// enum ไม่ถูกบังคับที่ระดับฐานข้อมูล ค่าที่เขียนลงต้องผ่าน zod ก่อนเสมอ
datasource db {
  provider = "sqlite"
}

// ============ enums ============

enum UserRole {
  STUDENT // นักศึกษา ยืนยันด้วยโดเมนอีเมลวิทยาลัย
  EXTERNAL // สถานประกอบการและบุคคลภายนอก
  ADMIN // ผู้ดูแลระบบ
}

enum Gender {
  MALE
  FEMALE
  PREFER_NOT
}

/// สถานะกลางของเนื้อหาทุกชนิด เนื้อหาเกิดมาเป็น PENDING เสมอ
/// ที่สาธารณะเห็นเฉพาะ APPROVED รวมถึงตัวนับและค่าเฉลี่ยด้วย
enum ContentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PostType {
  EXPERIENCE // เล่าประสบการณ์
  QA // ถามตอบ
  TIPS // เทคนิค
  TEAM // หาเพื่อนฝึกงาน
}

enum ReportStatus {
  PENDING
  RESOLVED // ลบเนื้อหาหรือจัดการแล้ว
  DISMISSED // ตรวจแล้วไม่ผิดกฎ
}

// ============ ผู้ใช้และการยืนยันตัวตน ============

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  role           UserRole  @default(EXTERNAL)
  isSuperAdmin   Boolean   @default(false)
  isBanned       Boolean   @default(false)
  // กรอกเมื่อคำขอยืนยันสิทธิ์นักศึกษาได้รับอนุมัติ
  studentId      String?
  department     String?
  educationLevel String?
  createdAt      DateTime  @default(now())

  accounts        Account[]
  sessions        Session[]
  reviews         Review[]
  posts           CommunityPost[]
  comments        CommunityComment[]
  likes           CommunityLike[]
  notifications   Notification[]
  reportsMade     Report[]           @relation("ReportAuthor")
  auditLogs       AuditLog[]         @relation("AuditAdmin")
  upgradeRequests UpgradeRequest[]
  employer        Employer?
}

// ตารางที่ Auth.js Prisma adapter ต้องใช้

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============ สถานประกอบการ ============

model Employer {
  id           String   @id @default(cuid())
  userId       String   @unique
  companyName  String
  contactEmail String // อีเมลติดต่อที่แสดงในประกาศ คนละตัวกับอีเมลบัญชี
  phone        String?
  departments  Json // แผนกวิชาที่เปิดรับ เป็นอาร์เรย์ของรหัสแผนก — SQLite ไม่รองรับ String[]
  createdAt    DateTime @default(now())

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  companies Company[]
  jobs      JobPosting[]
}

model Company {
  id            String   @id @default(cuid())
  name          String
  address       String?
  industry      String?
  lat           Float?
  lng           Float?
  phone         String?
  website       String?
  coverImageUrl String?
  description   String?
  isVerified    Boolean  @default(false)
  // place_id ของ Google Maps (ผ่าน SerpApi) — unique กันบริษัทเดียวกันถูกสร้างซ้ำเมื่อหลายคนเลือกจากผลค้นหา
  // SQLite ยอมให้ NULL ซ้ำได้ บริษัทที่กรอกเองจึงไม่ชนกัน
  googlePlaceId String?  @unique
  employerId    String?
  createdAt     DateTime @default(now())

  employer Employer?    @relation(fields: [employerId], references: [id], onDelete: SetNull)
  reviews  Review[]
  jobs     JobPosting[]
  reports  Report[]

  @@index([name])
}

// ============ รีวิว ============

model Review {
  id         String @id @default(cuid())
  companyId  String
  userId     String
  department String

  gender           Gender
  periodStart      DateTime
  periodEnd        DateTime
  dailyAllowance   Int?
  hasAccommodation Boolean  @default(false)
  hasTransport     Boolean  @default(false)
  workStartTime    String?
  workEndTime      String?

  // คะแนน 4 ด้าน scoreOverall คำนวณจากค่าเฉลี่ยของสี่ตัวนี้ ไม่ให้ผู้ใช้กรอกเอง
  scoreWork    Float
  scoreEnv     Float
  scoreMentor  Float
  scoreWelfare Float
  scoreOverall Float

  textWork   String
  textPros   String?
  textCons   String?
  textAdvice String?

  // ไม่ระบุตัวตน: ชื่อไม่แสดงต่อผู้ใช้คนอื่น ผู้ดูแลสืบได้จาก userId (docs/context.md หลักการข้อ 2)
  isAnonymous Boolean @default(false)

  status          ContentStatus @default(PENDING)
  rejectionReason String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos  ReviewPhoto[]
  reports Report[]

  // หนึ่งคนรีวิวหนึ่งบริษัทได้ครั้งเดียว บังคับที่ฐานข้อมูลแทนการเช็คในโค้ด
  @@unique([companyId, userId])
  @@index([status, department])
  @@index([status, companyId])
}

model ReviewPhoto {
  id        String   @id @default(cuid())
  reviewId  String
  url       String
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

// ============ ตำแหน่งงานฝึกงาน ============

model JobPosting {
  id             String  @id @default(cuid())
  companyId      String
  employerId     String
  title          String
  department     String
  description    String
  qualifications String?
  benefits       String?
  allowance      Int?
  contactEmail   String // อีเมลติดต่อในประกาศ ไม่ใช่อีเมลบัญชีผู้ลงประกาศ
  contactPhone   String?

  isActive        Boolean       @default(true)
  status          ContentStatus @default(PENDING)
  rejectionReason String?
  createdAt       DateTime      @default(now())

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employer Employer @relation(fields: [employerId], references: [id], onDelete: Cascade)
  reports  Report[]

  @@index([status, isActive, department])
  // ประกาศที่เปิดรับได้แผนกละหนึ่งต่อสถานประกอบการ (สูงสุดเท่าจำนวนแผนกที่ลงทะเบียน คือ 3)
  // บังคับที่ฐานข้อมูล — ประกาศที่ปิดรับหรือถูกปฏิเสธไม่นับ · เงื่อนไขต้องตรงกับ isOpen() ใน lib/job-rules.ts
  @@unique([employerId, department], map: "JobPosting_open_per_department", where: raw("\"isActive\" = 1 AND \"status\" <> 'REJECTED'"))
}

// ============ เว็บบอร์ดชุมชน ============

model CommunityPost {
  id         String   @id @default(cuid())
  userId     String
  type       PostType
  department String?
  title      String
  body       String

  // คำตอบที่ดีที่สุด (หมวดถามตอบ) — ชี้ที่ความคิดเห็นตัวเดียว ฐานข้อมูลจึงรับประกันหนึ่งคำตอบต่อกระทู้เอง
  // ลบความคิดเห็นนั้น = ล้างค่า (SetNull)
  bestAnswerId String? @unique

  status          ContentStatus @default(PENDING)
  rejectionReason String?
  createdAt       DateTime      @default(now())

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments   CommunityComment[] @relation("PostComments")
  bestAnswer CommunityComment?  @relation("BestAnswer", fields: [bestAnswerId], references: [id], onDelete: SetNull)
  likes    CommunityLike[]
  reports  Report[]

  @@index([status, type, department])
}

model CommunityComment {
  id       String  @id @default(cuid())
  postId   String
  userId   String
  parentId String? // คอมเมนต์ซ้อนเป็นลำดับชั้น ชี้ตัวเอง
  body     String

  status          ContentStatus @default(PENDING)
  rejectionReason String?
  createdAt       DateTime      @default(now())

  post         CommunityPost      @relation("PostComments", fields: [postId], references: [id], onDelete: Cascade)
  bestAnswerOf CommunityPost?     @relation("BestAnswer")
  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  CommunityComment?  @relation("CommentTree", fields: [parentId], references: [id], onDelete: Cascade)
  replies CommunityComment[] @relation("CommentTree")
  likes   CommunityLike[]
  reports Report[]

  @@index([postId, status])
}

/// กดถูกใจบัญชีละครั้ง บังคับด้วย unique ที่ฐานข้อมูล ไม่ใช่เช็คในโค้ดแล้วเจอ race condition
model CommunityLike {
  id        String   @id @default(cuid())
  userId    String
  postId    String?
  commentId String?
  createdAt DateTime @default(now())

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  post    CommunityPost?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment CommunityComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, commentId])
}

// ============ แจ้งเตือน รายงาน ประวัติผู้ดูแล ============

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String // approve_review, reject_post, approve_upgrade, ...
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model Report {
  id         String @id @default(cuid())
  reporterId String
  reason     String

  // ชี้ไปที่เนื้อหาชนิดใดชนิดหนึ่ง
  reviewId  String?
  postId    String?
  commentId String?
  jobId     String?
  companyId String?

  status     ReportStatus @default(PENDING)
  resolution String?
  createdAt  DateTime     @default(now())

  reporter User              @relation("ReportAuthor", fields: [reporterId], references: [id], onDelete: Cascade)
  review   Review?           @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  post     CommunityPost?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment  CommunityComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  job      JobPosting?       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  company  Company?          @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // เรื่องที่ยังรอตรวจต่อบัญชีต่อเนื้อหาได้เรื่องเดียว — ปิดแล้วรายงานใหม่ได้ (เนื้อหาอาจถูกแก้แล้วส่งกลับมา)
  // SQLite ยอม NULL ซ้ำ คอลัมน์เป้าหมายที่ไม่ใช้จึงไม่ชนกัน
  @@unique([reporterId, reviewId], map: "Report_pending_reviewId", where: raw("\"status\" = 'PENDING'"))
  @@unique([reporterId, postId], map: "Report_pending_postId", where: raw("\"status\" = 'PENDING'"))
  @@unique([reporterId, commentId], map: "Report_pending_commentId", where: raw("\"status\" = 'PENDING'"))
  @@unique([reporterId, jobId], map: "Report_pending_jobId", where: raw("\"status\" = 'PENDING'"))
  @@unique([reporterId, companyId], map: "Report_pending_companyId", where: raw("\"status\" = 'PENDING'"))
  @@index([status])
}

/// ทุกการกระทำของผู้ดูแลต้องมีแถวที่นี่ เขียนในทรานแซกชันเดียวกับการกระทำ
model AuditLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String // approve_review, reveal_anonymous, toggle_ban_user, ...
  targetType String // review, post, comment, job, user, report
  targetId   String
  detail     String?
  createdAt  DateTime @default(now())

  // Restrict: ลบบัญชีผู้ดูแลต้องไม่ลบประวัติ (หลักการโดเมนข้อ 3)
  admin User @relation("AuditAdmin", fields: [adminId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([action])
}

// ============ คำขอยืนยันสิทธิ์นักศึกษา ============

model UpgradeRequest {
  id             String @id @default(cuid())
  userId         String
  studentId      String
  department     String
  educationLevel String
  cardImageUrl   String

  status          ContentStatus @default(PENDING)
  rejectionReason String?
  createdAt       DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // คำขอที่รอตรวจได้ครั้งละหนึ่งต่อบัญชี — บังคับที่ฐานข้อมูล
  @@unique([userId], map: "UpgradeRequest_one_pending", where: raw("\"status\" = 'PENDING'"))
  @@index([status])
}
